#!/usr/bin/env bash

set -euo pipefail

REMOTE_NAME="${1:-origin}"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Only enforce branch pushes; tags and other refs pass through.
  if [[ "${remote_ref}" != refs/heads/* ]]; then
    continue
  fi

  remote_branch="${remote_ref#refs/heads/}"
  local_branch="${local_ref#refs/heads/}"

  if [[ "${remote_branch}" == "main" ]]; then
    cat <<'EOF'
Push blocked: direct pushes to 'main' are disabled.
Open a pull request from 'dev' into 'main' instead.
EOF
    exit 1
  fi

  if [[ "${remote_branch}" == "dev" && "${local_branch}" == "dev" ]]; then
    continue
  fi

  if [[ "${remote_branch}" == feat/* && "${local_branch}" == feat/* ]]; then
    continue
  fi

  if [[ "${remote_branch}" == "fix"/* && "${local_branch}" == "fix"/* ]]; then
    continue
  fi

  if [[ "${remote_branch}" == "chore"/* && "${local_branch}" == "chore"/* ]]; then
    continue
  fi

  if [[ "${remote_branch}" == "hotfix"/* && "${local_branch}" == "hotfix"/* ]]; then
    continue
  fi

  cat <<EOF
Push blocked: allowed direct pushes are 'dev', 'feat/*', 'fix/*', 'chore/*', 'hotfix/*'.
Tried to push local '${local_branch}' to remote '${remote_branch}' on '${REMOTE_NAME}'.
EOF
  exit 1
done

exit 0